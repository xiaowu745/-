# 复制此文件为 .env 并填入真实配置

# Claude API Key（必填）
ANTHROPIC_API_KEY=sk-ant-xxxxx

# 使用的模型（推荐 Sonnet 控制成本，重要场景用 Opus）
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# 数据库（MVP阶段可以不用，用内存存储）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skill_agent

# Redis（MVP阶段可以不用）
REDIS_URL=redis://localhost:6379/0

# JWT 密钥
SECRET_KEY=change-me-in-production

# 调试模式
DEBUG=true
